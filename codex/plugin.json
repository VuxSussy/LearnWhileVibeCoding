{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "vibe-learning",
  "version": "2.1.0",
  "description": "Learn while you vibe code: Claude explains every step in 2-3 plain lines, shows what it did, tours the functions in a file, names the algorithms it finds, breaks down the hard bugs it solved, lets you write key lines and type the git/npm commands yourself, and has an ADHD-friendly mode.",
  "author": {
    "name": "VuxSussy",
    "url": "https://github.com/VuxSussy"
  },
  "homepage": "https://github.com/VuxSussy/VibeLearning",
  "repository": "https://github.com/VuxSussy/VibeLearning",
  "license": "MIT",
  "keywords": [
    "learning",
    "education",
    "vibe-coding",
    "beginner",
    "adhd",
    "accessibility",
    "debugging",
    "tutor",
    "algorithms",
    "code-explanation"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "VibeLearning",
        "shortDescription": "Learn while you vibe code",
        "developerName": "VuxSussy",
        "category": "Education",
        "defaultPrompt": "$explain"
      }
    }
  }
}
